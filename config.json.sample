{
  "readonly_metashrew_db_dir": "/root/.metashrew/",
  "electrum_rpc_url": null,
  "metashrew_rpc_url": "http://127.0.0.1:8090",
  "electrs_esplora_url": "http://127.0.0.1:3003",
  "bitcoind_rpc_url": "http://127.0.0.1:8332",
  "bitcoind_rpc_user": "rpc",
  "bitcoind_rpc_pass": "rpc",
  "bitcoind_blocks_dir": "~/.bitcoin/blocks",
  "reset_mempool_on_startup": false,
  "db_path": "./db",
  "sdb_poll_ms": 5000,
  "indexer_block_delay_ms": 0,
  "port": 8082,
  "explorer_host": "0.0.0.0:8083",
  "explorer_base_path": "/",
  "google_analytics_tag": null,
  "mempool": {
    "enabled": true,
    "raw_poll_secs": 60,
    "template_poll_secs": 10,
    "trace_workers": 1,
    "hydration_workers": 16,
    "clear_protection_secs": 180,
    "max_txs": 100000,
    "template_blocks": 8,
    "block_weight_units": 4000000,
    "template_recalc_ms": 2000,
    "zmq_rawtx_url": null,
    "zmq_sequence_url": null,
    "websocket_enabled": true,
    "websocket_path": "/api/events/ws"
  },
  "network": "mainnet",
  "metashrew_db_label": null,
  "strict_mode": {
    "check_utxos": false,
    "check_alkane_balances": false,
    "check_trace_mismatches": false
  },
  "debug": false,
  "safe_tip_hook_script": null,
  "block_source_mode": "rpc",
  "debug_backup": null,
  "explorer_networks": {
    "mainnet": "https://explorer.example.com",
    "signet": "https://signet.example.com",
    "testnet3": "https://testnet.example.com",
    "testnet4": "https://testnet4.example.com",
    "regtest": "http://127.0.0.1:5081"
  },
  "modules": {
    "runes": {
      "enable": false,
      "load_live_outpoints": true
    },
    "ammdata": {
      "coingecko": {
        "api_url": "https://pro-api.coingecko.com",
        "api_key": "YOUR_COINGECKO_API_KEY",
        "timeout_secs": 10
      },
      "espo_pricer_host": "http://127.0.0.1:6901",
      "use_historical_backfill": true,
      "store_price_every_block": true,
      "pre_ammdata_btc_usd_price": 100000,
      "search_index_enabled": false,
      "search_prefix_min": 2,
      "search_prefix_max": 6,
      "search_fallback_scan_cap": 5000,
      "search_limit_cap": 20
    },
    "subfrost": {}
  }
}
